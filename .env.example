# Docker Compose provides DATABASE_URL and STORAGE_DIR. For a local backend use SQLite.
DATABASE_URL=sqlite:///./catalogue.db
STORAGE_DIR=./uploads

# Optional: store original CSV files in an existing Azure Blob container.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=supplier-catalogues

# Optional: advisory AI review. Use a JSON-output-capable Azure deployment.
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
